{
  "name": "driftcast-receiver",
  "productName": "Driftcast Receiver",
  "version": "0.1.0",
  "description": "Shows an Android phone's screen and sound on this PC over Wi-Fi",
  "main": "src/main.js",
  "author": "Hajj Abdul Hakim",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/protocol.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.driftcast.receiver",
    "productName": "Driftcast Receiver",
    "files": ["src/**/*", "ui/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "Driftcast-Receiver-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Driftcast Receiver",
      "include": "build/installer.nsh"
    }
  }
}
